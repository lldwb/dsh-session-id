{
  "name": "dsh-session-id",
  "version": "0.2.0",
  "description": "会话增强：一键复制会话 ID、让 Agent 按 ID 查找会话与子代理，并把会话分享成免登录只读链接。",
  "type": "module",
  "license": "MIT",
  "private": true,
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "test/**"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "session",
    "session-id",
    "subagent",
    "clipboard",
    "share"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lldwb/dsh-session-id.git"
  },
  "homepage": "https://github.com/lldwb/dsh-session-id#readme",
  "bugs": {
    "url": "https://github.com/lldwb/dsh-session-id/issues"
  },
  "meta": {
    "title": "会话增强",
    "description": "复制会话 ID、按 ID 查看会话与子代理，并把会话分享成免登录只读链接。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
