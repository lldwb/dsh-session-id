{
  "name": "dsh-session-id",
  "version": "2.0.0",
  "description": "会话增强：复制会话 ID、按 ID 查会话与子代理、把会话分享成免登录只读链接，并在模型失败/停止后一键重试。三个可单独启停的组件。",
  "type": "module",
  "license": "MIT",
  "private": true,
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./share": "./share/index.js",
    "./retry": "./retry/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./share/locale/*.json": "./share/locale/*.json",
    "./retry/locale/*.json": "./retry/locale/*.json",
    "./share/icon": "./icon.svg",
    "./retry/icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "share/**",
    "retry/**",
    "lib/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "test/**"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "session",
    "session-id",
    "subagent",
    "clipboard",
    "share",
    "retry",
    "turn",
    "model-request"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lldwb/dsh-session-id.git"
  },
  "homepage": "https://github.com/lldwb/dsh-session-id#readme",
  "bugs": {
    "url": "https://github.com/lldwb/dsh-session-id/issues"
  },
  "meta": {
    "title": "会话增强",
    "description": "三个独立组件：复制会话 ID 并按 ID 查会话与子代理；把会话分享成免登录只读链接；模型失败或停止后一键重试。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
